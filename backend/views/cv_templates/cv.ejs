<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Professional CV template for <%= data.userData.name %>. Includes experience, education, skills, and contact details."
    />
    <title>CV Template</title>
    <link rel="stylesheet" href="/css/cv.css" />
  </head>
  <body>
    <div class="a4-page">
      <div class="intro">
        <div class="bgSig"></div>
        <div class="name"><%= data.userData.name %></div>
        <div class="position">
          <%= data.cvData?.exp?.[data.cvData.exp.length - 1].position %>
        </div>
      </div>

      <div class="expBoxConatiner">
        <div class="boxTwo">
          <!-- EDUCATION SECTION -->
          <div class="edu">
            <div class="title"><strong>E</strong>DUCATION</div>
            <% if (data.cvData.education && data.cvData.education.length > 0) {
            %> <% data.cvData.education.forEach(function(edu) { %>
            <div class="eduData">
              <div class="duration"><%= edu.duration %></div>
              <div class="name"><%= edu.name %></div>
              <li class="program"><%= edu.program %></li>
              <li class="gpa">CGPA: <%= edu.cgpa %></li>
            </div>
            <% }); %> <% } else { %>
            <div class="eduData">
              <div class="name">No education data available</div>
            </div>
            <% } %>
          </div>

          <!-- SKILLS SECTION -->
          <div class="skills">
            <div class="title"><strong>S</strong>KILLS</div>
            <ul>
              <% if (data.cvData.skills && data.cvData.skills.length > 0) { %>
              <% data.cvData.skills.forEach(function(skill) { %>
              <li><%= skill %></li>
              <% }); %> <% } else { %>
              <li>No skills listed</li>
              <% } %>
            </ul>
          </div>

          <!-- LANGUAGE SECTION -->
          <div class="language">
            <div class="title"><strong>L</strong>ANGUAGE</div>
            <ul>
              <li>Hindi</li>
              <li>English</li>
            </ul>
          </div>
        </div>

        <!-- EXPERIENCE SECTION -->
        <div class="exp">
          <div class="title"><strong>W</strong>ORK EXPERIENCE</div>
          <% if (data.cvData.exp && data.cvData.exp.length > 0) { %> <%
          data.cvData.exp.forEach(function(expItem) { %>
          <div class="company">
            <div class="compDetail">
              <div class="name"><%= expItem.name %></div>
              <div class="duration"><%= expItem.duration %></div>
            </div>
            <div class="position"><%= expItem.position %></div>
            <div class="workExp">
              <% expItem.pointers.forEach(function(point) { %>
              <li><%= point %></li>
              <% }) %>
            </div>
          </div>
          <% }) %> <% } else { %>
          <p>No experience available</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- PDF Download Button -->
    <img
      id="downloadBtn"
      src="/assets/pdf.svg"
      alt="Download PDF"
      style="cursor: pointer; z-index: 1000; height: 14mm"
    />

    <!-- Script to trigger PDF generation -->
    <script>
      document
        .getElementById('downloadBtn')
        .addEventListener('click', async () => {
          const htmlContent = document.querySelector('.a4-page').outerHTML

          const response = await fetch('/pdf/generate-pdf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ html: htmlContent })
          })

          const blob = await response.blob()
          const url = URL.createObjectURL(blob)

          const link = document.createElement('a')
          link.href = url
          link.download = 'resume.pdf'
          link.click()

          URL.revokeObjectURL(url)
        })
    </script>
  </body>
</html>
