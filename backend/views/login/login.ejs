<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Auth Form</title>
</head>
<body>
    <h2 id="formTitle">Signup</h2>

    <form id="signupForm" action="/api/signup" method="POST">
        <div>
            <label>Name:</label>
            <input type="text" name="name" required />
        </div>
        <div>
            <label>Password:</label>
            <input type="password" name="password" required />
        </div>
        <button type="submit">Signup</button>
    </form>

    <form id="loginForm" action="/login" method="POST" style="display: none;">
        <div>
            <label>Name:</label>
            <input type="text" name="name" required />
        </div>
        <div>
            <label>Password:</label>
            <input type="password" name="password" required />
        </div>
        <button type="submit">Login</button>
    </form>

    <button onclick="toggleForms()">Switch to Login</button>

    <script>
        let isSignup = true;

        function toggleForms() {
            const signupForm = document.getElementById('signupForm');
            const loginForm = document.getElementById('loginForm');
            const formTitle = document.getElementById('formTitle');
            const toggleBtn = document.querySelector('button[onclick="toggleForms()"]');

            if (isSignup) {
                signupForm.style.display = 'none';
                loginForm.style.display = 'block';
                formTitle.textContent = 'Login';
                toggleBtn.textContent = 'Switch to Signup';
            } else {
                signupForm.style.display = 'block';
                loginForm.style.display = 'none';
                formTitle.textContent = 'Signup';
                toggleBtn.textContent = 'Switch to Login';
            }

            isSignup = !isSignup;
        }
    </script>
</body>
</html>
